# Miniflare-hosted Cloudflare Workers runtime for local E2E / demo deployments.
# Builds the runtime-agnostic Hono app via the Cloudflare entry, then serves
# it with Miniflare on 0.0.0.0:8787.
#
# Build (from src/edge/):
#   docker build -f Dockerfile.miniflare -t fora/edge-miniflare:dev .

FROM node:22-slim AS builder
# @fora-protocol/sdk is a git dependency on the protocol repository, pinned to
# one full 40-hex commit: between protocol releases the edge, the Go services and
# the e2e harness all build from the same commit of the protocol's integration
# branch (scripts/check-sdk-pin-consistency.sh holds the three pins together).
# npm installs the repository's root package.json, which presents the TypeScript
# SDK under sdk/ts; the import specifiers stay "@fora-protocol/sdk/...". At the
# next protocol release the pin goes back to an exact registry version.
#
# For a GitHub spec pinned to a commit, npm first fetches the codeload tarball of
# that commit over HTTPS and falls back to a real `git clone` only when the
# tarball fetch fails. git is installed for that fallback and for nothing else:
# without it the normal path works and the fallback fails, on a machine nobody is
# watching. The lock records the commit and the tarball's sha512, and `npm ci`
# installs exactly that commit. No sibling checkout is mirrored in and any
# shallow workdir works.
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
# Persist npm's download cache across builds — every tarball this step
# downloads, the SDK's codeload tarball among them. The mount lives with the
# builder, so nothing here reaches a layer.
#
# id, because BuildKit otherwise names a cache mount after its target: all three
# npm mounts in this stack would be ONE cache, and sharing=locked would then make
# the second and third image wait for the first. Compose builds them
# concurrently. Per image, each keeps a warm cache with a single writer.
RUN --mount=type=cache,id=npm-edge-miniflare,target=/root/.npm,sharing=locked \
    npm ci --include=dev
COPY . .
RUN node scripts/build-worker.mjs --out dist/worker.mjs

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/scripts ./scripts
# The Workers runtime settings serve-miniflare.mjs runs under, from the same
# file every publisher's wrangler.toml is written from.
COPY --from=builder /app/edgerelease/workers-compat.json ./edgerelease/workers-compat.json
COPY --from=builder /app/dist ./dist

EXPOSE 8787
USER node
ENTRYPOINT ["node", "scripts/serve-miniflare.mjs"]
