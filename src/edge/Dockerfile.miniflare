# Miniflare-hosted Cloudflare Workers runtime for local E2E / demo deployments.
# Builds the runtime-agnostic Hono app via the Cloudflare entry, then serves
# it with Miniflare on 0.0.0.0:8787.
#
# Build (from src/edge/):
#   docker build -f Dockerfile.miniflare -t fora/edge-miniflare:dev .

FROM node:22-slim AS builder
# @fora-protocol/sdk is installed from the npm registry at an exact release
# version, the same release the Go module and the two PyPI distributions name.
# npm records a sha512 integrity for it and verifies that against the downloaded
# tarball on every install, so the bytes this image builds on are pinned rather
# than merely named. No sibling checkout is mirrored in and any shallow workdir
# works.
#
# It used to be a git pin at a commit SHA, which needed a paragraph of its own
# here: npm fetched a codeload tarball for it and fell back to a real clone when
# that failed, so `git` had to be installed for a path almost nothing took. The
# registry install needs neither, and the apt layer went with the pin.
WORKDIR /app
COPY package.json package-lock.json ./
# Persist npm's download cache across builds — every registry tarball this step
# downloads, the SDK's among them. The mount lives with the builder, so nothing
# here reaches a layer.
#
# id, because BuildKit otherwise names a cache mount after its target: all three
# npm mounts in this stack would be ONE cache, and sharing=locked would then make
# the second and third image wait for the first. Compose builds them
# concurrently. Per image, each keeps a warm cache with a single writer.
RUN --mount=type=cache,id=npm-edge-miniflare,target=/root/.npm,sharing=locked \
    npm ci --include=dev
COPY . .
RUN node scripts/build-worker.mjs --out dist/worker.mjs

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/scripts ./scripts
# The Workers runtime settings serve-miniflare.mjs runs under, from the same
# file every publisher's wrangler.toml is written from.
COPY --from=builder /app/edgerelease/workers-compat.json ./edgerelease/workers-compat.json
COPY --from=builder /app/dist ./dist

EXPOSE 8787
USER node
ENTRYPOINT ["node", "scripts/serve-miniflare.mjs"]
