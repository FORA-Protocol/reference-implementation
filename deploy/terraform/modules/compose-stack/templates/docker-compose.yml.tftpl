# FORA staging stack — rendered by Terraform (modules/compose-stack).
# Do not edit on the VM: changes belong in the Terraform templates.
#
# This file is also the own-DC reference bundle: a publisher running the stack
# on their own hardware runs exactly these services with their own values.

name: fora

services:
%{ if !external_database ~}
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: fora
      POSTGRES_PASSWORD: "${postgres_password}"
      POSTGRES_DB: fora
    ports:
      # Published on the VM's LOOPBACK interface only, so an operator reaches
      # it through `ssh -L 5432:127.0.0.1:5432` and nothing else can. Postgres
      # here has one superuser role and a generated password; a wildcard bind
      # (0.0.0.0, or dropping the 127.0.0.1 prefix, which means the same thing)
      # would put that role on the public internet.
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
      # First-cluster-init SQL (extra exchange databases, if any). Runs once;
      # wiping the pgdata volume re-runs it.
      - /opt/fora/init-sql:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fora -d fora"]
      interval: 5s
      timeout: 3s
      retries: 20

%{ endif ~}
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: ["redis-server", "--save", "60", "1", "--loglevel", "warning"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
%{ if tigerbeetle_enabled }
  # Single-replica TigerBeetle ledger for per-article accounting. The flags
  # are mandatory: Docker >= 25 blocks io_uring without seccomp=unconfined,
  # and TigerBeetle locks memory (IPC_LOCK). --development relaxes Direct IO
  # for overlay/cloud volumes. Static IP because the Exchange's
  # EXCHANGE_BILLING_TB_ADDRESS accepts IP:port only, never a hostname.
  tigerbeetle:
    image: ghcr.io/tigerbeetle/tigerbeetle:0.17.8
    restart: unless-stopped
    entrypoint: ["sh", "-c"]
    command:
      - |
        set -e
        [ -f /data/0_0.tigerbeetle ] || /tigerbeetle format --cluster=0 --replica=0 --replica-count=1%{ if tigerbeetle_development } --development%{ endif } /data/0_0.tigerbeetle
        exec /tigerbeetle start --addresses=0.0.0.0:3000 --cache-grid=${tigerbeetle_cache_grid}%{ if tigerbeetle_development } --development%{ endif } /data/0_0.tigerbeetle
    security_opt:
      - "seccomp=unconfined"
    cap_add:
      - "IPC_LOCK"
    volumes:
      - tbdata:/data
    networks:
      default:
        ipv4_address: ${tigerbeetle_ip}
%{ endif }
  exchange:
    image: ${exchange_image}
    restart: unless-stopped
%{ if tigerbeetle_enabled }
    # The embedded TigerBeetle client uses io_uring, which Docker >= 25
    # blocks in its default seccomp profile — the Exchange needs the same
    # exception as the tigerbeetle service or the client dies with
    # "failed to initialize IO: PermissionDenied" at boot.
    security_opt:
      - "seccomp=unconfined"
%{ endif }
    environment:
      EXCHANGE_DSN: "${database_dsns.fora}"
      # System of Record — its OWN logical database, a second pool distinct from
      # EXCHANGE_DSN above. FORA_SOR_ADAPTER defaults to postgres and there is
      # no "off", so this is required: unset, the Exchange exits at boot with
      # "sor: EXCHANGE_SOR_DSN is required for FORA_SOR_ADAPTER=postgres". The
      # database is created by the init SQL (see main.tf locals.databases) —
      # the Exchange migrates it but never creates it.
      EXCHANGE_SOR_DSN: "${database_dsns.sor}"
      EXCHANGE_ADDR: ":8081"
      # Source addresses allowed to call the admin listener. An empty value
      # denies EVERY request (the middleware is fail-closed), so leaving this
      # unset makes the published admin port below answer 403 to everything.
      #
      # It is the compose network's own subnet, NOT 127.0.0.1: publishing a
      # port makes Docker rewrite the source address to the network's gateway
      # (host 1 of this subnet), so the container never sees loopback. The
      # middleware reads RemoteAddr and deliberately ignores X-Forwarded-For,
      # so no header can widen this — the CIDR is the only control.
      #
      # Interpolated from the network_subnet variable, the same value the
      # networks block below uses, so the two cannot drift apart.
      ADMIN_ALLOWED_CIDRS: "${network_subnet}"
      # Offer.exchange routing key: the public hostname, port-less — the
      # Broker fetches https://<domain>/.well-known/fora.json from it.
      EXCHANGE_DOMAIN: "${exchange_hostname}"
      EXCHANGE_PUBLIC_ORIGIN: "https://${exchange_hostname}"
%{ if terms_currency != null ~}
      # The denomination publishers' licensing is priced in. The catalog
      # importer below gets the same two values: it prices imported entries in
      # them, and they must be what the console previewed to the publisher.
      EXCHANGE_TERMS_CURRENCY: "${terms_currency}"
%{ endif ~}
%{ if terms_unit != null ~}
      EXCHANGE_TERMS_UNIT: "${terms_unit}"
%{ endif ~}
      # The tenant whose activation policy agent Register reads. It is the
      # PUBLISHER's domain, not the Exchange's: the seed step creates the tenant
      # row under the publisher hostname. Left unset the binary falls back to
      # EXCHANGE_DOMAIN above, no tenant row matches, and every Register fails
      # with a default-tenant-not-seeded error — which also means no agent ever
      # gets a billing_ref, so nothing can be charged.
      EXCHANGE_DEFAULT_TENANT: "${default_tenant_domain}"
      # One-time welcome credit for each newly registered agent, in WHOLE
      # units of the ledger currency: "100" on the default EUR ledger grants
      # EUR 100.00 per agent, not 100 cents. "0" disables the grant. This
      # variable is the sole owner of the setting — every boot overwrites the
      # default tenant's stored value with it.
      EXCHANGE_DEFAULT_AGENT_CREDIT: "${default_agent_credit}"
      FORA_BILLING_ADAPTER: "${billing_adapter}"
%{ if tigerbeetle_enabled }
      EXCHANGE_BILLING_TB_ADDRESS: "${tigerbeetle_ip}:3000"
      # ISO 4217 numeric currency of the ledger — the adapter refuses to boot
      # without it.
      EXCHANGE_BILLING_LEDGER: "${billing_ledger}"
%{ endif }
      # https is the production default; stated explicitly so this file never
      # silently inherits a compose-network http override.
      FORA_WELLKNOWN_SCHEME: "https"
      # Caddy terminates TLS and proxies plain HTTP to this container; it sets
      # X-Forwarded-Proto (replacing any client-supplied value), so signature
      # verification must run against the https URL the caller signed, not the
      # plain-HTTP socket scheme. Safe here ONLY because the service is not
      # directly reachable — Caddy owns the public ports.
      FORA_TRUST_PROXY_HEADERS: "true"
      # Revocation authority — the Exchange refuses to boot when this is
      # unset, but never fetches it at boot. While DNS + Caddy certs + the
      # Broker come up on first boot (a few minutes) the running Exchange
      # rejects signed requests with 401 and recovers on its own.
      EXCHANGE_BROKER_WELLKNOWN_URL: "https://${broker_hostname}/.well-known/fora.json"
      FORA_ED25519_PRIVATE_PEM_FILE: "/keys/ed25519-private.pem"
%{ if rsa_enabled }
      # Only AWS_CLOUDFRONT_RSA tenants use this. Omitting it is a supported
      # posture, not a broken one: the Exchange starts without an RSA key and
      # refuses only the requests that would need it, naming the setting to add.
      FORA_RSA_PRIVATE_PEM_FILE: "/keys/rsa-private.pem"
%{ endif }
%{ if registration_schema_env != null ~}
      # Published as account_registration.data_schema AND enforced on Register
      # — the manifest and the gate read the same loaded value, so the Exchange
      # cannot advertise one shape while refusing on another. Already quoted
      # and escaped by the module (jsonencode for YAML, doubled dollars for
      # Compose's own interpolation), so it carries no quotes here.
      EXCHANGE_REGISTRATION_SCHEMA: ${registration_schema_env}
%{ endif ~}
%{ if terms_uri != null ~}
      EXCHANGE_TERMS_URI: "${terms_uri}"
%{ endif ~}
%{ if terms_digest != null ~}
      # A registering client must echo this. Publishing it for the first time
      # refuses every client that does not yet send it — absent and stale are
      # the same failure.
      EXCHANGE_TERMS_DIGEST: "${terms_digest}"
%{ endif ~}
%{ if console_enabled ~}
      # Turns the publisher console's routes on. The first names the console's
      # key directory, at the console's own origin, which the console's calls
      # are verified against. The second is the contributor host every
      # publisher's file must name, the same value the console writes into
      # it. The Exchange refuses to boot with the first set and not the second.
      EXCHANGE_CONSOLE_WELLKNOWN_URL: "${console_origin}/.well-known/http-message-signatures-directory"
      EXCHANGE_CATALOG_CONTRIBUTOR_HOST: "${console_contributor_host}"
%{ endif ~}
    ports:
      # The admin listener (ADMIN_ADDR, default :8082). The container-side 8082
      # is this container's own port — the Broker's :8082 belongs to a different
      # container and is not published, so the two never collide on the host.
      #
      # Bound to the VM's LOOPBACK interface, so it is reachable only through
      # `ssh -L 8082:127.0.0.1:8082`. Keep the 127.0.0.1 prefix: this listener
      # has NO login of any kind, only the source-address allowlist above, so a
      # wildcard bind would hand the admin plane to the internet.
      - "127.0.0.1:8082:8082"
    volumes:
      # Per-service key directory: each container sees ONLY its own keys, so a
      # compromise of one service does not hand over another service's signing
      # identity.
      - /opt/fora/keys/exchange:/keys:ro
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
    # The image is distroless (no shell/curl), so the probe is the service
    # binary itself (`exchange healthcheck` GETs the local /healthz). While
    # the service is still coming up on first boot the container reports
    # unhealthy — that is the honest status; restart: unless-stopped waits
    # it out.
    healthcheck:
      test: ["CMD", "/exchange", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
    depends_on:
%{ if !external_database ~}
      postgres:
        condition: service_healthy
%{ endif ~}
%{ if tigerbeetle_enabled }
      tigerbeetle:
        condition: service_started
%{ endif }
      broker:
        condition: service_healthy
%{ if importer_enabled ~}

  # The automatic catalog importer: the Exchange image with its second
  # entrypoint, and its OWN key directory. It is a job, not a daemon: the
  # systemd timer cloud-init installs runs it as
  #   docker compose --profile importer run --rm importer
  # and the profile keeps `docker compose up` from starting it. A separate
  # service rather than `docker compose run` on the exchange service, on
  # purpose: `run` inherits the service's volumes, which would hand the
  # Exchange process the contributor key the importer signs with.
  importer:
    image: ${exchange_image}
    entrypoint: ["/fora-import"]
    profiles: ["importer"]
    restart: "no"
    environment:
      EXCHANGE_DSN: "${database_dsns.fora}"
      EXCHANGE_DOMAIN: "${exchange_hostname}"
      # Dialled at the public hostname through Caddy, like every other
      # contributor: the push is signed over that authority and verified
      # against it.
      IMPORT_EXCHANGE_URL: "https://${exchange_hostname}"
      IMPORT_KEY_FILE: "/keys/contributor-key.json"
      # Per-run bounds, applied to one listing at a time. These are the
      # binary's own defaults, written out so an operator sees and changes
      # them in one place.
      IMPORT_REQUEST_TIMEOUT: "10s"
      IMPORT_MAX_DOC_BYTES: "1048576"
      IMPORT_MAX_DOCUMENTS: "100"
      IMPORT_MAX_RESOURCES: "10000"
      IMPORT_LISTING_TIMEOUT: "5m"
%{ if terms_currency != null ~}
      # The Exchange service's denomination, from the same inputs: the price a
      # publisher saw in the console is the price their pages are imported at.
      EXCHANGE_TERMS_CURRENCY: "${terms_currency}"
%{ endif ~}
%{ if terms_unit != null ~}
      EXCHANGE_TERMS_UNIT: "${terms_unit}"
%{ endif ~}
    volumes:
      # Only the contributor key, and only here.
      - /opt/fora/keys/importer:/keys:ro
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
%{ endif ~}

  broker:
    image: ${broker_image}
    restart: unless-stopped
    environment:
      BROKER_DSN: "${database_dsns.fora}"
      REDIS_URL: "redis://redis:6379/0"
      BROKER_ADDR: ":8082"
      BROKER_ID: "${broker_id}"
      BROKER_DOMAIN: "${broker_hostname}"
      FORA_WELLKNOWN_SCHEME: "https"
      # Same TLS-termination contract as the exchange: Caddy sets
      # X-Forwarded-Proto and owns the public ports, so verification runs
      # against the https URL the agent signed.
      FORA_TRUST_PROXY_HEADERS: "true"
      BROKER_RELAY_KEY_FILE: "/keys/broker-relay-key.json"
      # The Broker's IDENTITY key — NOT the relay key above. Its public half is
      # published in the Broker's WBA directory with a 90-day validity window,
      # so it has to survive a restart: the Broker refuses to boot without it
      # rather than mint a throwaway that breaks the window it just published.
      # A key FILE, not a BROKER_ED25519_SEED env value: this compose file is
      # world-readable on the VM, the mounted key directory is not. The loader
      # wants a raw 64-byte ed25519 key as the PEM payload — a shape openssl
      # does not write; gen-keys.sh derives it from the seed into
      # keys/broker-identity-key.pem.
      BROKER_ED25519_KEY_FILE: "/keys/broker-identity-key.pem"
      BROKER_REVOCATION_URL: "https://${broker_hostname}/.well-known/fora-key-revocations.json"
%{ if exa_api_key != null }
      EXA_API_KEY: "${exa_api_key}"
%{ endif }
%{ if query_discovery != null ~}
      # Catalog search: a free-text query is matched against this feed through
      # the model. The Broker's key pair for the model is a file in its own
      # key directory, so it is not in this environment; the metadata service
      # is never asked.
      BROKER_QUERY_DISCOVERY: "on"
      BROKER_QUERY_CATALOG_FILE: "/catalog/feed.jsonl"
      BROKER_QUERY_MODEL: "${query_discovery.model}"
      AWS_REGION: "${query_discovery.aws_region}"
      AWS_SHARED_CREDENTIALS_FILE: "/keys/aws-credentials"
      AWS_EC2_METADATA_DISABLED: "true"
%{ endif ~}
    volumes:
      - /opt/fora/keys/broker:/keys:ro
%{ if query_discovery != null ~}
      - /opt/fora/catalog/feed.jsonl:/catalog/feed.jsonl:ro
%{ endif ~}
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
    # Same distroless-image constraint as the exchange: the binary is the probe.
    healthcheck:
      test: ["CMD", "/broker", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
    depends_on:
%{ if !external_database ~}
      postgres:
        condition: service_healthy
%{ endif ~}
      redis:
        condition: service_healthy

  # ── Identity plane ─────────────────────────────────────────────────────────
  # The Identity Service custodies each agent's signing key (identity-vault),
  # provisions agents through real OIDC sign-up (zitadel), publishes each
  # agent's Web Bot Auth directory on its own subdomain, and exposes the MCP
  # endpoint agents connect to.

%{ if vault_mode == "dev" ~}
  # Agent key custody. DEV MODE, and that is a deliberate staging trade-off:
  # the store is in-memory, so restarting this container destroys every agent
  # key it holds and the developers who own them must sign up again. Dev mode
  # also auto-unseals and pre-enables the KV v2 mount at `secret/` that
  # IDENTITY_KV_MOUNT points at. A production deployment runs a sealed Vault
  # with real storage and a real auth method instead of a root token.
  identity-vault:
    image: hashicorp/vault:1.20
    restart: unless-stopped
    cap_add:
      - "IPC_LOCK"
    environment:
      VAULT_DEV_ROOT_TOKEN_ID: "${vault_root_token}"
      VAULT_DEV_LISTEN_ADDRESS: "0.0.0.0:8200"
    command: ["server", "-dev"]
    healthcheck:
      test: ["CMD", "vault", "status", "-address=http://127.0.0.1:8200"]
      interval: 5s
      timeout: 3s
      retries: 20
%{ else ~}
  # Agent key custody, SERVER MODE: raft storage on the vaultdata volume,
  # TLS and the server configuration from /opt/fora/vault on the host. The
  # stack that turns server mode on writes those three directories, as
  # deploy/storage/vault/DEPLOYMENT.md describes; this bundle only mounts them
  # (server config as a read-only directory — the image's entrypoint chowns
  # it and logs a warning about the read-only mount, which is harmless).
  # `server` alone: the entrypoint appends -config=/vault/config itself.
  #
  # Host networking so the seal (a cloud KMS) and the Proxy's auth below reach
  # the instance metadata service in one hop; the bridge would add a second.
  # Nothing else in the bundle addresses this container by name — the
  # Identity Service talks to the Proxy's socket, never to Vault directly.
  identity-vault:
    image: hashicorp/vault:1.20
    restart: unless-stopped
    network_mode: host
    cap_add:
      - "IPC_LOCK"
    environment:
      # For the healthcheck's CLI call: Vault itself listens where the server
      # config says, and the config is what puts it on 127.0.0.1:8200 TLS.
      VAULT_ADDR: "https://127.0.0.1:8200"
      VAULT_CACERT: "/vault/tls/vault.crt"
    command: ["server"]
    volumes:
      - vaultdata:/vault/file
      - vaultlogs:/vault/logs
      - /opt/fora/vault/server:/vault/config:ro
      - /opt/fora/vault/tls:/vault/tls:ro
    # `vault status` exits 2 when Vault is sealed or not yet initialised, and
    # it IS sealed on first boot until the operator initialises it. That
    # counts as healthy here: the container answers. Only a Vault that does
    # not answer at all (exit 1) is unhealthy. Compose reads $VAR itself, so
    # the shell's `$?` is doubled to survive its interpolation.
    healthcheck:
      test: ["CMD-SHELL", "vault status >/dev/null 2>&1; rc=$$?; [ $$rc -eq 0 ] || [ $$rc -eq 2 ]"]
      interval: 5s
      timeout: 3s
      retries: 20

  # Vault Proxy: authenticates to the Vault above on the Identity Service's
  # behalf (the auth method and its role are in the proxy config the stack
  # writes) and proxies its API calls, so the service holds no Vault
  # token at all. The listener is a Unix socket in the vaultproxy volume,
  # mounted by this service and by identity ONLY: no TCP port, so no other
  # container in the bundle can borrow the Identity Service's Vault access.
  # The config is read from /vault/proxy, deliberately NOT /vault/config —
  # the server loads that whole directory and would refuse a proxy stanza.
  #
  # The socket crosses a uid boundary: the image runs vault as uid 100, the
  # Identity Service is distroless nonroot, uid and gid 65532. The shape
  # chosen: the proxy process runs as 100:65532, so the socket it creates is
  # group-owned by 65532, and the proxy config opens it 0660. A fresh named
  # volume mounted where the image has no directory is root-owned 0755, and
  # uid 100 could not create the socket in it — so the container starts as
  # root, hands the socket directory to 100:65532 first, then drops to that
  # identity with the image's own su-exec. That replaces the image
  # entrypoint, which only ever chowns the server's directories anyway.
  # That the Identity Service can connect as 65532 is a deployment-time
  # check on the host; the template tests only prove who mounts the volume.
  vault-proxy:
    image: hashicorp/vault:1.20
    restart: unless-stopped
    network_mode: host
    entrypoint: ["sh", "-c"]
    command:
      - |
        set -e
        chown 100:65532 /vault-proxy && chmod 0750 /vault-proxy
        exec su-exec 100:65532 vault proxy -config=/vault/proxy/proxy.hcl
    environment:
      VAULT_ADDR: "https://127.0.0.1:8200"
      VAULT_CACERT: "/vault/tls/vault.crt"
    volumes:
      - /opt/fora/vault/proxy:/vault/proxy:ro
      - /opt/fora/vault/tls:/vault/tls:ro
      - vaultproxy:/vault-proxy
    depends_on:
      identity-vault:
        condition: service_started
%{ endif ~}

%{ if !external_database ~}
  # Zitadel's own database, deliberately not the `fora` cluster: Zitadel runs
  # heavy schema migrations under its own roles, and keeping them off the
  # cluster that serves the Exchange and Broker means neither can take the
  # other down.
  zitadel-db:
    image: postgres:17-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: zitadel
      POSTGRES_PASSWORD: "${zitadel_db_password}"
      POSTGRES_DB: zitadel
    volumes:
      - zitadeldata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U zitadel -d zitadel"]
      interval: 5s
      timeout: 3s
      retries: 20

%{ endif ~}
  # Upstream OIDC provider for developer sign-up. ExternalDomain/Secure
  # describe the PUBLIC address because the OIDC issuer must be one URL
  # everywhere: the developer's browser is redirected to it, and the Identity
  # Service validates tokens against the same string. tlsMode external because
  # Caddy terminates TLS in front.
  zitadel:
    image: ghcr.io/zitadel/zitadel:v3.4.9
    restart: unless-stopped
    # Runs as root so first init can write its PAT into the bootstrap volume,
    # which Docker creates owned by root. Staging-only shortcut; a production
    # deployment pre-creates the volume with the image's own uid instead.
    user: "0"
    command:
      - ${external_database ? "start-from-setup" : "start-from-init"}
      - --masterkey
      - "${zitadel_masterkey}"
      - --tlsMode
      - external
      - --steps
      - /etc/zitadel/init-steps.yaml
    environment:
      ZITADEL_EXTERNALDOMAIN: "${zitadel_hostname}"
      ZITADEL_EXTERNALPORT: "443"
      ZITADEL_EXTERNALSECURE: "true"
      ZITADEL_PORT: "8080"
      ZITADEL_TLS_ENABLED: "false"
      ZITADEL_DATABASE_POSTGRES_HOST: "${external_database ? database_host : "zitadel-db"}"
      ZITADEL_DATABASE_POSTGRES_PORT: "${external_database ? database_port : 5432}"
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: "${zitadel_db_password}"
%{ if external_database ~}
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: verify-full
      ZITADEL_DATABASE_POSTGRES_USER_SSL_ROOTCERT: /db-ca/ca.pem
%{ else ~}
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: zitadel
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: "${zitadel_db_password}"
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
%{ endif ~}
%{ if smtp_enabled ~}
      # Outbound mail, for the confirmation code self-registration sends. Read
      # ONLY while Zitadel creates an instance: on the first start, and when
      # the System API creates the publishers' instance. After that each
      # instance's provider is stored in Zitadel's database and these values
      # are ignored. Editing them here changes the VM's user data, which
      # rebuilds the whole deployment; editing a running provider is a console
      # or Admin API job, once per instance.
      #
      # jsonencode on every interpolated value: a JSON string literal is also
      # a valid YAML scalar, so a password holding a quote or a backslash
      # cannot break the document.
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_HOST: ${jsonencode(smtp_host)}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_USER: ${jsonencode(smtp_user)}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_SMTP_PASSWORD: ${jsonencode(smtp_password)}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_TLS: "true"
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROM: ${jsonencode(smtp_from)}
      ZITADEL_DEFAULTINSTANCE_SMTPCONFIGURATION_FROMNAME: ${jsonencode(smtp_from_name)}
%{ endif ~}
%{ if zitadel_system_api_users != null ~}
      # The System API user that creates the publishers' instance, and in a
      # recovery window mints that instance a new bootstrap token. Only the
      # public half of its key is here; Caddy answers 404 for the System API
      # on every public hostname, so only the compose network reaches it.
      ZITADEL_SYSTEMAPIUSERS: ${jsonencode(zitadel_system_api_users)}
%{ endif ~}
    volumes:
      - /opt/fora/zitadel/init-steps.yaml:/etc/zitadel/init-steps.yaml:ro
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
      # First init writes the bootstrap machine user's PAT here; the identity
      # bootstrap script reads it, and writes the minted OIDC client id and
      # secret back into the same volume for the identity service to read.
      - zitadelbootstrap:/bootstrap
%{ if !external_database ~}
    depends_on:
      zitadel-db:
        condition: service_healthy
%{ endif ~}

  identity:
    image: ${identity_image}
    restart: unless-stopped
    environment:
      IDENTITY_ADDR: ":8083"
      IDENTITY_DSN: "${database_dsns.identity}"
      # Its own zone: agent directories are served at <slug>.<this>, and the
      # service refuses any host that is not a single label under it.
      IDENTITY_BASE_DOMAIN: "${identity_hostname}"
      IDENTITY_WELLKNOWN_SCHEME: "https"
%{ if mcp_split ~}
      # The service's own public origin: the OAuth issuer and the base of the
      # /callback URL registered with Zitadel — changing it invalidates that
      # registration. The MCP endpoint is served under its own name, so the
      # audience of the bearers the service mints, which is also the protected
      # resource the endpoint advertises, follows that name instead: an MCP
      # client refuses to sign in when the advertised resource is not the
      # origin it connected to. Changing the audience invalidates every bearer
      # issued before the change.
      IDENTITY_AUTH_ISSUER: "https://${identity_hostname}"
      IDENTITY_TOKEN_AUDIENCE: "https://${mcp_hostname}"
%{ else ~}
      # The service's own public origin. It is the OAuth issuer, the audience
      # of the bearers it mints, and the base of the /callback URL registered
      # with Zitadel — changing it invalidates that registration.
      IDENTITY_AUTH_ISSUER: "https://${identity_hostname}"
%{ endif ~}
      IDENTITY_OIDC_ISSUER: "https://${zitadel_hostname}"
      # Minted by the identity bootstrap script into the shared volume. Until
      # it has run, this container crash-loops on the missing files;
      # restart: unless-stopped picks it up once the files appear.
      IDENTITY_OIDC_CLIENT_ID_FILE: "/bootstrap/identity_client_id"
      IDENTITY_OIDC_CLIENT_SECRET_FILE: "/bootstrap/identity_client_secret"
      IDENTITY_OIDC_SCOPES: "openid profile email"
      # Both are generated once and held in Terraform state. Left unset the
      # service invents them per boot, which silently invalidates every live
      # session and every bearer it has issued on each restart.
      IDENTITY_SESSION_KEY: "${identity_session_key}"
      IDENTITY_TOKEN_SIGNING_KEY: "${identity_token_signing_key}"
%{ if vault_mode == "dev" ~}
      VAULT_ADDR: "http://identity-vault:8200"
      VAULT_TOKEN: "${vault_root_token}"
%{ else ~}
      # The Vault Proxy's socket, and no VAULT_TOKEN: the Proxy authenticates
      # and attaches its own token to every proxied call. The Vault client
      # library dials unix:// addresses natively.
      VAULT_ADDR: "unix:///vault-proxy/proxy.sock"
%{ endif ~}
      IDENTITY_KV_MOUNT: "${vault_kv_mount}"
      # The one in-network hop the MCP tools still take. Discovery goes to the
      # Broker; everything Exchange-facing is resolved per call.
      IDENTITY_MCP_BROKER_URL: "http://broker:8082"
      # No Exchange origin, deliberately: an account call names its Exchange by
      # the domain that Exchange publishes about itself, and the endpoint comes
      # from that Exchange's own manifest. This deployment runs one, so the
      # policy names it and nothing else — an agent cannot make this host sign
      # and send to an Exchange the operator did not choose.
      IDENTITY_MCP_EXCHANGE_ALLOWLIST: "${exchange_hostname}"
      IDENTITY_MCP_WELLKNOWN_SCHEME: "https"
    volumes:
      - zitadelbootstrap:/bootstrap:ro
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
%{ if vault_mode == "server" ~}
      # Read-only is enough to connect to the Proxy's socket: connecting is
      # a permission check on the socket inode, not a write to the mount.
      - vaultproxy:/vault-proxy:ro
%{ endif ~}
    # The image is distroless (no shell/curl), so the probe is the service
    # binary itself (`identity healthcheck` GETs the local /healthz) — same
    # shape as the Exchange and Broker. During the documented first-boot
    # crash-loop the container reports unhealthy — that is the honest status;
    # restart: unless-stopped rides it out.
    healthcheck:
      test: ["CMD", "/identity", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
    depends_on:
%{ if !external_database ~}
      postgres:
        condition: service_healthy
%{ endif ~}
%{ if vault_mode == "dev" ~}
      identity-vault:
        condition: service_healthy
%{ else ~}
      # service_started, NOT service_healthy, for both: on first boot Vault
      # is sealed until the operator initialises it, and the Proxy cannot
      # authenticate before that. Waiting on health here would hold the
      # Identity Service back forever. The service does not probe Vault at
      # start-up: it comes up, reports healthy, and its key operations fail
      # until the Proxy is listening on the socket — then they succeed with
      # no restart needed.
      identity-vault:
        condition: service_started
      vault-proxy:
        condition: service_started
%{ endif ~}
      zitadel:
        condition: service_started

%{ if publisher_enabled }
  # Demo publisher origin (staging only): serves the demo content tree the
  # edge worker's ORIGIN_URL points at.
  publisher:
    image: ${publisher_image}
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1/articles/philosophers/thales-of-miletus.txt >/dev/null || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 20
%{ endif }
%{ if onboarding_enabled }
  # Onboarding preview service: the server behind the public publisher
  # onboarding page. No state, no other service, reached through Caddy only —
  # no ports: mapping, so 8084 stays on the compose network. Its address guard
  # stays armed: the two environment overrides that drop the private-address
  # check before a dial and permit plain http are deliberately not inputs of
  # this module, because with either set a visitor can point the service at
  # this host's own network. Their names never appear in the rendered bundle,
  # and the module's tests assert exactly that.
  onboarding:
    image: ${jsonencode(onboarding_image)}
    restart: unless-stopped
    environment:
      ONBOARDING_ADDR: ":8084"
      # Caddy forwards this prefix unchanged; the service mounts its routes
      # under it, so there is no rewrite on either side.
      ONBOARDING_PATH_PREFIX: "/onboarding"
      ONBOARDING_ALLOWED_ORIGINS: ${jsonencode(onboarding_allowed_origins)}
      ONBOARDING_EXCHANGE_DOMAIN: ${jsonencode(onboarding_exchange_domain)}
      ONBOARDING_EXCHANGE_ENDPOINT: ${jsonencode(onboarding_exchange_endpoint)}
      # Caddy terminates TLS in front: read the forwarded scheme and spend the
      # rate-limit budget from the forwarded address. Unset, every request
      # arrives from the proxy and the whole internet shares one bucket.
      FORA_TRUST_PROXY_HEADERS: "true"
%{ if onboarding_contact_enabled ~}
      # The contact form's relay: the same SES sender and credential Zitadel
      # uses. The visitor's address is Reply-To, never the sender.
      ONBOARDING_CONTACT_RECIPIENTS: ${jsonencode(onboarding_contact_recipients)}
      ONBOARDING_CONTACT_FROM: ${jsonencode(onboarding_contact_from)}
      ONBOARDING_SMTP_ADDR: ${jsonencode(smtp_host)}
      ONBOARDING_SMTP_USERNAME: ${jsonencode(smtp_user)}
      ONBOARDING_SMTP_PASSWORD: ${jsonencode(smtp_password)}
%{ endif ~}
    healthcheck:
      # Distroless image: no shell, no curl. The binary is its own probe.
      test: ["CMD", "/onboarding", "healthcheck"]
      interval: 10s
      timeout: 3s
      retries: 3
%{ endif }
%{ if console_enabled ~}
  # Publisher console: the web application a publisher signs in to, registers
  # their sites through, and downloads their setup files from. Reached through
  # Caddy only: no ports: mapping, so 8085 stays on the compose network. Its
  # address guard stays on, because it reads pages from publishers' own sites:
  # the overrides that drop the private-address check and permit plain http
  # are not inputs of this module.
  console:
    image: ${jsonencode(console_image)}
    restart: unless-stopped
    environment:
      CONSOLE_ADDR: ":8085"
      CONSOLE_DSN: "${database_dsns.console}"
      # Generated once and held in Terraform state. The console has no
      # per-process fallback, and a new value signs every publisher out.
      CONSOLE_SESSION_KEY: "${console_session_key}"
      CONSOLE_SIGNING_KEY_FILE: "/keys/console-signing-key.pem"
      # The console's public origin: the Exchange reads its key directory
      # here, and the sign-in redirect below returns here.
      CONSOLE_PUBLIC_ORIGIN: "${console_origin}"
      # The publishers' own Zitadel instance at its public issuer, through
      # Caddy, as the Identity Service reaches the developers' instance. It is
      # the only issuer the console trusts. The client id and secret are read
      # from a host directory of the console's own, never the shared bootstrap
      # volume: that volume also holds the developer instance's admin token.
      # Until both files exist the console exits at boot, and
      # restart: unless-stopped starts it again.
      CONSOLE_OIDC_ISSUER: "${console_login_url}"
      CONSOLE_OIDC_CLIENT_ID_FILE: "/console-oidc/console_client_id"
      CONSOLE_OIDC_CLIENT_SECRET_FILE: "/console-oidc/console_client_secret"
      CONSOLE_OIDC_REDIRECT_URL: "${console_origin}/auth/callback"
      CONSOLE_OIDC_SCOPES: "openid profile email"
      # The public Exchange, not an internal address: the console also writes
      # these values into every publisher's fora.json.
      CONSOLE_EXCHANGE_URL: "https://${exchange_hostname}"
      CONSOLE_EXCHANGE_DOMAIN: "${exchange_hostname}"
      CONSOLE_EXCHANGE_WBA_URL: "https://${exchange_hostname}/.well-known/http-message-signatures-directory"
      CONSOLE_CONTRIBUTOR_HOST: "${console_contributor_host}"
      CONSOLE_SUPPORT_EMAIL: ${jsonencode(console_support_email)}
%{ if console_default_rate != null ~}
      CONSOLE_DEFAULT_RATE: "${console_default_rate}"
%{ endif ~}
    volumes:
      # Only the console's own key directory, and only here.
      - /opt/fora/keys/console:/keys:ro
      - /opt/fora/console-oidc:/console-oidc:ro
%{ if external_database ~}
      - /opt/fora/database/ca.pem:/db-ca/ca.pem:ro
%{ endif ~}
    healthcheck:
      # Distroless image: no shell, no curl. The binary is its own probe.
      test: ["CMD", "/console", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
    # Caddy must not wait on the console: at boot the console reads the login
    # provider's discovery document through Caddy.
    depends_on:
%{ if !external_database ~}
      postgres:
        condition: service_healthy
%{ endif ~}
      zitadel:
        condition: service_started

%{ endif ~}
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
%{ if acme_eab_key_id != null ~}
    # The EAB credentials the Caddyfile's acme_eab block reads.
    environment:
      ACME_EAB_KEY_ID: ${jsonencode(acme_eab_key_id)}
      ACME_EAB_MAC_KEY: ${jsonencode(acme_eab_mac_key)}
%{ endif ~}
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/fora/Caddyfile:/etc/caddy/Caddyfile:ro
%{ if wba_enabled ~}
      # Static Web Bot Auth key directories written by cloud-init; the
      # Caddyfile's per-hostname site blocks serve them with file_server.
      - /opt/fora/wba:/srv/wba:ro
%{ endif ~}
%{ if terms_enabled ~}
      # Terms documents written by cloud-init. Caddy runs in this container,
      # so the Caddyfile's `root * /srv/exchange-terms` resolves HERE, not on
      # the host — without this mount file_server would serve nothing.
      - /opt/fora/exchange-terms:/srv/exchange-terms:ro
%{ endif ~}
%{ if caddy_data_dir != null ~}
      # The certificates and the ACME account, on the EBS volume cloud-init
      # mounts here, so they outlive the VM. Read-write: Caddy renews in place.
      - ${caddy_data_dir}:/data
%{ else ~}
      - caddydata:/data
%{ endif ~}
      - caddyconfig:/config
    depends_on:
      # Deliberately NOT service_healthy: the Exchange's first boot needs
      # Caddy live (its broker well-known fetch goes over public HTTPS
      # through this proxy), so waiting for a healthy Exchange here would
      # deadlock the cold boot. Caddy answers 502 until the Exchange is up.
      exchange:
        condition: service_started
      broker:
        condition: service_healthy
      # Both for the same reason as the Exchange: the Identity Service reaches
      # Zitadel's issuer over public HTTPS through this proxy, so Caddy must
      # not wait on either of them — service_healthy here would deadlock the
      # cold boot even though identity now has its own healthcheck.
      identity:
        condition: service_started
      zitadel:
        condition: service_started

networks:
  default:
    ipam:
      config:
        - subnet: ${network_subnet}

volumes:
%{ if !external_database ~}
  pgdata:
%{ endif ~}
  redisdata:
%{ if tigerbeetle_enabled }
  tbdata:
%{ endif }
%{ if !external_database ~}
  zitadeldata:
%{ endif ~}
  # Zitadel's first-init PAT plus the OIDC client id/secret the bootstrap
  # script mints from it. Keep it consistent with the Zitadel database
  # when restoring, whether that database is local or external.
  zitadelbootstrap:
%{ if caddy_data_dir == null ~}
  caddydata:
%{ endif ~}
  caddyconfig:
%{ if vault_mode == "dev" ~}
  # identity-vault runs in dev mode and stores nothing on disk, so it has no
  # volume here. That is what makes a restart lose the agent keys.
%{ else ~}
  # Vault's raft store — the ONLY copy of every agent key — and its audit
  # log. Both must sit on storage that outlives the host.
  vaultdata:
  vaultlogs:
  # The Proxy's socket directory: mounted by vault-proxy and identity only.
  vaultproxy:
%{ endif ~}
