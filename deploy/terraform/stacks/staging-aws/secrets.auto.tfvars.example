# Copy to secrets.auto.tfvars (gitignored — the *.auto.tfvars pattern).
# Terraform loads *.auto.tfvars automatically; keeping the secrets in this
# separate file means terraform.tfvars stays safe to screen-share or paste.
# Alternative: skip the file and export TF_VAR_cloudflare_api_token /
# TF_VAR_registry_password instead.

cloudflare_api_token = "..."

# Only when the images are private (the VM's pull-only token):
# registry_password = "..."

# Optional catalog search through an Elasticsearch index someone else maintains.
# The index owner's search template builds the query: template_id names one
# stored in the cluster, or, instead, template holds its text, which the Broker
# sends with every search. hit_url_path is where each hit carries its URL.
# api_key is the base64 "encoded" value of a read-only key. ca_pem is needed only
# for a private CA, and replaces the system roots for this connection.
# filters_schema declares the search_filters keys the template applies, and the
# MCP endpoint publishes it to agents; without it every filter is refused. The
# one below is the repository's example, deploy/broker/search-filters.example.json:
# a tfvars file cannot read a file, so the schema is pasted in. Excludes the
# model-backed catalog search.
# elasticsearch_search = {
#   url            = "https://search.example:9243"
#   index          = "catalog"
#   template_id    = "fora-catalog"
#   hit_url_path   = "_source.url"
#   result_limit   = 50
#   timeout        = "3s"
#   api_key        = "..."
#   ca_pem         = <<-EOT
#     -----BEGIN CERTIFICATE-----
#     ...
#     -----END CERTIFICATE-----
#   EOT
#   filters_schema = <<-EOT
#     {
#       "$schema": "https://json-schema.org/draft/2020-12/schema",
#       "title": "Search filters this deployment's catalog search applies",
#       "description": "Example filter vocabulary for the elasticsearch provider. Each key is applied by the search template, which reads it as filters.<key>. A key not listed here is refused with UNIMPLEMENTED, and a value that breaks its key's rule with INVALID_ARGUMENT.",
#       "type": "object",
#       "additionalProperties": false,
#       "properties": {
#         "news.language": {
#           "description": "Only articles in this language: a two-letter lower-case ISO 639-1 code, for example \"en\".",
#           "type": "string",
#           "pattern": "^[a-z]{2}$"
#         },
#         "news.date_published_after": {
#           "description": "Only articles published at or after this instant: a UTC date-time to the second, for example \"2026-01-05T00:00:00Z\".",
#           "type": "string",
#           "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
#         }
#       }
#     }
#   EOT
# }
