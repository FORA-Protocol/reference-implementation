# Copy to secrets.auto.tfvars (gitignored — the *.auto.tfvars pattern).
# Terraform loads *.auto.tfvars automatically; keeping the secrets in this
# separate file means terraform.tfvars stays safe to screen-share or paste.
# Alternative: skip the file and export TF_VAR_registry_password /
# TF_VAR_exa_api_key instead.

# Only when the images are private (the VM's pull-only token):
# registry_password = "..."

# Only with acme_ca and acme_eab_key_id in terraform.tfvars: the EAB HMAC key
# (b64MacKey from gcloud publicca external-account-keys create):
# acme_eab_mac_key = "..."

# Optional EXA API key for Broker discovery:
# exa_api_key = "..."
