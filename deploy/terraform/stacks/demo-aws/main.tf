# All-inclusive FORA demo on AWS: one EC2 VM running the Compose stack
# (Postgres, Redis, TigerBeetle, Exchange, Broker, the Identity Service with
# its Vault and Zitadel, Caddy, demo origin), Route 53 records for the service
# hostnames, and a CloudFront distribution whose viewer-request Lambda@Edge
# function runs the SAME Ed25519 edge worker the Cloudflare deployments run —
# for a domain whose DNS stays in Route 53.
#
# Every hostname nests under one label (demo.<domain> and its children), so
# the whole deployment adds records to a shared zone without touching anything
# else in it.
#
# Key material under keys/ comes from ../../scripts/gen-keys.sh demo-aws.
# The Lambda bundle is built by
# ../../scripts/build-lambda-edge.sh from the config this stack renders — see
# the lambda_edge_config output and the deploy_edge variable for the
# bootstrap order.

locals {
  publisher_fqdn = "${var.publisher_subdomain}.${var.domain}"

  # Zone-relative record names ("exchange.demo") and full hostnames
  # ("exchange.demo.<domain>") for the five service names under the publisher
  # label.
  exchange_record   = "${var.exchange_subdomain}.${var.publisher_subdomain}"
  broker_record     = "${var.broker_subdomain}.${var.publisher_subdomain}"
  identity_record   = "${var.identity_subdomain}.${var.publisher_subdomain}"
  mcp_record        = "${coalesce(var.mcp_subdomain, var.identity_subdomain)}.${var.publisher_subdomain}"
  zitadel_record    = "${var.zitadel_subdomain}.${var.publisher_subdomain}"
  origin_record     = "${var.origin_subdomain}.${var.publisher_subdomain}"
  onboarding_record = "${var.onboarding_subdomain}.${var.publisher_subdomain}"

  exchange_fqdn   = "${local.exchange_record}.${var.domain}"
  broker_fqdn     = "${local.broker_record}.${var.domain}"
  identity_fqdn   = "${local.identity_record}.${var.domain}"
  zitadel_fqdn    = "${local.zitadel_record}.${var.domain}"
  origin_fqdn     = "${local.origin_record}.${var.domain}"
  onboarding_fqdn = "${local.onboarding_record}.${var.domain}"

  # The MCP endpoint has a hostname of its own only while mcp_subdomain names
  # one; then the compose-stack module pins the token audience to it.
  mcp_fqdn  = "${local.mcp_record}.${var.domain}"
  mcp_split = local.mcp_fqdn != local.identity_fqdn

  # The onboarding service exists only when an image names it; the hostname
  # and its DNS record follow the image so a demo without one is unchanged.
  onboarding_enabled = var.onboarding_image != null

  # The smoke identities: each hostname IS the identity's id (its kid, its
  # fora.agents row, and the host its public key directory is served at).
  # They nest under the publisher label like every other name in this stack,
  # so the id the key-gen script derives on a first run must be
  # <label>.<publisher_subdomain>.<domain> — set STAGING_DOMAIN to the
  # publisher hostname (demo.<domain>), not the zone apex.
  smoke_agent_record         = "${var.smoke_agent_subdomain}.${var.publisher_subdomain}"
  catalog_contributor_record = "${var.catalog_contributor_subdomain}.${var.publisher_subdomain}"
  smoke_agent_fqdn           = "${local.smoke_agent_record}.${var.domain}"
  catalog_contributor_fqdn   = "${local.catalog_contributor_record}.${var.domain}"

  image_base      = "${var.image_registry}/${var.image_prefix}"
  exchange_image  = "${local.image_base}/exchange:${var.image_tag}"
  broker_image    = "${local.image_base}/broker:${var.image_tag}"
  identity_image  = "${local.image_base}/identity:${var.image_tag}"
  publisher_image = "${local.image_base}/publisher:${var.image_tag}"

  # Default to the in-repo bundle location: build-lambda-edge.sh writes it
  # there, and when the bundle is missing the module's fileexists validation
  # fails the plan with a message pointing at the build script instead of
  # failing obscurely.
  lambda_zip_path = coalesce(var.lambda_zip_path, "${path.module}/../../../../src/edge/dist/lambda-edge.zip")

  # Key material generated by gen-keys.sh into the gitignored keys/
  # directory next to this stack (run it with STACK_DIR set to this
  # directory). agent-key.json is written by the same script but stays local
  # — no service on the VM needs it. contributor-key.json ships to the VM for
  # the catalog importer service alone (importer_key_json below).
  keys_dir = "${path.root}/keys"
  # Optional: the Exchange only needs it for AWS_CLOUDFRONT_RSA tenants, which
  # the demo has none of — the CloudFront distribution here does NOT use
  # CloudFront's native RSA signed URLs (Ed25519 verification runs inside the
  # Lambda). gen-keys.sh writes one anyway; deleting it is a supported
  # posture.
  rsa_private_pem = fileexists("${local.keys_dir}/rsa-private.pem") ? file("${local.keys_dir}/rsa-private.pem") : null

  # The per-deployment config baked into the Lambda bundle, rendered HERE so
  # the bundle and the stack can never disagree on a hostname. The operator
  # writes it to a file (terraform output -raw lambda_edge_config) and feeds
  # it to build-lambda-edge.sh. Lambda@Edge has no environment variables, so
  # unlike the cloudflare-edge module these values travel inside the zip.
  #
  # ORIGIN_URL and SAME_ZONE_ORIGIN are deliberately ABSENT: with no origin
  # mode the shared worker answers an authorized request with the pass-through
  # marker, the AWS entry returns the CloudFront request object, and
  # CloudFront itself fetches the origin (origin.demo.<domain>) configured on
  # the distribution. The Lambda never proxies article bodies.
  lambda_edge_config = merge(
    {
      EXCHANGE_URL              = "https://${local.exchange_fqdn}"
      EXCHANGE_WBA_URL          = "https://${local.exchange_fqdn}/.well-known/http-message-signatures-directory"
      PROVIDER                  = local.publisher_fqdn
      EXCHANGES_JSON            = module.manifest.exchanges_json
      CATALOG_CONTRIBUTORS_JSON = module.manifest.catalog_contributors_json
      LICENSED_PATHS_JSON       = jsonencode(var.licensed_paths)
    },
    var.fora_enforce_binding == null ? {} : { FORA_ENFORCE_BINDING = var.fora_enforce_binding },
  )
}

# Resource-free, so it is always evaluated — including the bootstrap apply
# with deploy_edge = false, where the rendered config must exist before the
# bundle (and therefore before module.edge) can.
module "manifest" {
  source = "../../modules/publisher-manifest"

  exchange_fqdn     = local.exchange_fqdn
  resource_owner_id = var.resource_owner_id
  # The contributor id IS the hostname its key directory is served at (the
  # smoke identity hostname derived above) — there is no separate id variable.
  catalog_contributor_id = local.catalog_contributor_fqdn
}

module "compose_stack" {
  source = "../../modules/compose-stack"

  exchange_hostname = local.exchange_fqdn
  broker_hostname   = local.broker_fqdn
  identity_hostname = local.identity_fqdn
  mcp_hostname      = local.mcp_fqdn
  zitadel_hostname  = local.zitadel_fqdn
  origin_hostname   = local.origin_fqdn

  exchange_image  = local.exchange_image
  broker_image    = local.broker_image
  identity_image  = local.identity_image
  publisher_image = local.publisher_image

  registry_server   = var.registry_username == null ? null : var.image_registry
  registry_username = var.registry_username
  registry_password = var.registry_password

  billing_adapter = var.billing_adapter
  acme_email      = var.acme_email
  acme_staging    = var.acme_staging
  # Another CA while Let's Encrypt rate-limits the hostnames. Caddy keeps the
  # ACME account on the data volume below, so an EAB key is used once, by the
  # first VM, and later redeploys reuse the account and its certificates.
  acme_ca          = var.acme_ca
  acme_eab_key_id  = var.acme_eab_key_id
  acme_eab_mac_key = var.acme_eab_mac_key
  # Caddy's certificates and ACME account live on the VM module's data volume,
  # which survives the VM replacement redeploy-demo.sh does. Without it every
  # redeploy requests every certificate again, and Let's Encrypt allows only 5
  # for the same set of hostnames in 7 days. Only Caddy's data goes there: Postgres,
  # Zitadel, TigerBeetle and Vault stay on the root disk, so a redeploy still
  # resets the demo.
  caddy_data_volume_id = module.vm.data_volume_id
  exa_api_key          = var.exa_api_key
  query_discovery      = local.query_discovery

  # The seat is the Exchange itself, so its tenant row is keyed on the
  # Exchange's own hostname. The publisher is a separate record the seeding step
  # registers as a site listed on this seat.
  default_tenant_domain = local.exchange_fqdn
  default_agent_credit  = var.default_agent_credit

  # Outbound mail through the SES identity in ses.tf, so developer
  # self-registration can send its confirmation code. Zitadel stores these
  # when it first creates its instance, so they reach it through the VM's
  # user data — which means changing any of them replaces the VM and rebuilds
  # the deployment from empty.
  smtp_host      = local.zitadel_smtp_host
  smtp_user      = aws_iam_access_key.zitadel_smtp.id
  smtp_password  = aws_iam_access_key.zitadel_smtp.ses_smtp_password_v4
  smtp_from      = local.zitadel_smtp_from
  smtp_from_name = local.zitadel_smtp_from_name

  # The onboarding preview service, behind the public publisher onboarding
  # page. Its previewed offer names this demo's Exchange (the module defaults
  # the Exchange inputs to exchange_hostname). Its contact form relays through
  # the same SES sender and credential as Zitadel above: the IAM policy in
  # ses.tf pins ses:FromAddress to that one sender, so the from address here
  # can be nothing else.
  onboarding_hostname           = local.onboarding_enabled ? local.onboarding_fqdn : null
  onboarding_image              = var.onboarding_image
  onboarding_allowed_origins    = var.onboarding_allowed_origins
  onboarding_contact_recipients = var.onboarding_contact_recipients
  onboarding_contact_from       = length(var.onboarding_contact_recipients) > 0 ? local.zitadel_smtp_from : null

  # There is no keys.json / static key file: every verification key is
  # learned via well-known discovery — the Broker publishes its own keys, an
  # agent's key is fetched from the agent's own directory, and the smoke
  # identities' directories are served by this stack below.
  ed25519_private_pem     = file("${local.keys_dir}/ed25519-private.pem")
  rsa_private_pem         = local.rsa_private_pem
  broker_relay_key_json   = file("${local.keys_dir}/broker-relay-key.json")
  broker_identity_key_pem = file("${local.keys_dir}/broker-identity-key.pem")

  # PUBLIC key directories for the smoke identities, pre-signed (gen-keys.sh
  # derives them from the local keypairs and signs each for its hostname with
  # the listed key — the private halves never leave the operator's machine).
  # Caddy serves each at its identity's hostname with its response
  # signatures, which is how the Exchange and Broker verify the smoke and
  # ingest signatures.
  static_wba_directories = {
    (local.smoke_agent_fqdn)         = file("${local.keys_dir}/smoke-agent-wba.json")
    (local.catalog_contributor_fqdn) = file("${local.keys_dir}/catalog-contributor-wba.json")
  }

  # The automatic catalog importer signs as the contributor identity whose
  # directory is served above. The private key ships to the VM for the
  # importer service only; the Exchange never sees it.
  importer_key_json = file("${local.keys_dir}/contributor-key.json")

  # What this Exchange asks of an agent opening an account, and the terms that
  # agent accepts by registering. Set here rather than in tfvars because a
  # tfvars file holds literal values only — no function calls, no path.module —
  # so the digest below could not be derived there at all. These are deployment
  # behaviour, not operator choices.
  #
  # Publishing the schema IS the enforcement switch: from the moment it is set,
  # a registration missing legal_entity, or carrying a member the schema does
  # not name, is refused. Publishing the digest refuses any client that does not
  # echo it. Both breaks are real and land together — the harness change that
  # keeps registration working ships in the same commit.
  #
  # One required member and one optional, on purpose. A schema whose members are
  # all required never shows an agent the difference between must-send and
  # may-send, which is the reasoning a published schema exists to drive.
  #
  # The member names are the System of Record's own typed fields, so the demo
  # exercises the reference implementation's typed mapping rather than dropping
  # everything into its untyped extra blob.
  #
  # No "format": "email" on the address: the deployed validator does not assert
  # format, so declaring it would describe a constraint that never fires — worse
  # than declaring nothing, because it stops the next reader checking.
  exchange_registration_schema = jsonencode({
    "$schema"            = "https://json-schema.org/draft/2020-12/schema"
    type                 = "object"
    additionalProperties = false
    required             = ["legal_entity"]
    properties = {
      legal_entity = { type = "string", minLength = 1, maxLength = 200 }
      email        = { type = "string", maxLength = 254 }
    }
  })

  exchange_terms_uri = "https://${local.exchange_fqdn}/terms/revision-1.txt"

  # Derived from the tracked file, never written by hand: the published digest
  # has to equal the digest of the bytes actually SERVED, and the only way to
  # keep those two in step is to compute one from the other.
  exchange_terms_digest = "sha256:${filesha256("${path.module}/terms/revision-1.txt")}"

  # Every revision ever published stays in this map. A digest identifies a
  # document, so removing an old revision leaves the registrations accepted
  # under it pointing at nothing. Adding revision 2 is one entry here and one
  # digest line above.
  exchange_terms_documents = {
    "revision-1.txt" = file("${path.module}/terms/revision-1.txt")
  }
}

module "vm" {
  source = "../../modules/aws-vm"

  name_prefix   = var.name_prefix
  instance_type = var.instance_type
  ssh_operators = var.ssh_operators
  # Without comments: with catalog search on, the commented user data is over
  # EC2's 16 KB limit.
  user_data = module.compose_stack.user_data_without_comments
  # Caddy's /data only (see caddy_data_volume_id above); certificates take a
  # few MB, and 1 GiB is the smallest gp3 volume.
  data_volume_gb = 1
}

module "dns" {
  source = "../../modules/route53-dns"

  zone_id = var.route53_zone_id
  a_records = merge({
    (local.exchange_record) = module.vm.public_ip
    (local.broker_record)   = module.vm.public_ip
    (local.identity_record) = module.vm.public_ip
    (local.zitadel_record)  = module.vm.public_ip
    (local.origin_record)   = module.vm.public_ip
    # The smoke identities' key directory hostnames — Caddy serves each
    # identity's signed key directory there (static_wba_directories above).
    (local.smoke_agent_record)         = module.vm.public_ip
    (local.catalog_contributor_record) = module.vm.public_ip
    # Agent Web Bot Auth directories: one hostname per agent, created by a
    # developer signing up rather than by Terraform, so the record has to be a
    # wildcard. Caddy mints each subdomain's certificate on demand.
    ("*.${local.identity_record}") = module.vm.public_ip
    },
    # The onboarding hostname, only while the service is enabled.
    local.onboarding_enabled ? { (local.onboarding_record) = module.vm.public_ip } : {},
    # The MCP endpoint's own hostname, only while it differs from the
    # Identity hostname.
    local.mcp_split ? { (local.mcp_record) = module.vm.public_ip } : {},
  )

  # The publisher hostname aliases the CloudFront distribution (A + AAAA).
  # Only when the edge is deployed — during bootstrap (deploy_edge = false)
  # the name stays unclaimed rather than pointing anywhere wrong.
  alias_records = var.deploy_edge ? {
    (var.publisher_subdomain) = {
      target_domain  = module.edge[0].distribution_domain_name
      target_zone_id = module.edge[0].distribution_hosted_zone_id
    }
  } : {}
}

module "edge" {
  count  = var.deploy_edge ? 1 : 0
  source = "../../modules/aws-cloudfront-edge"

  # Lambda@Edge and the CloudFront certificate must live in us-east-1
  # regardless of the VM's region.
  providers = { aws = aws.us_east_1 }

  name_prefix     = var.name_prefix
  lambda_zip_path = local.lambda_zip_path
  hostname        = local.publisher_fqdn
  zone_id         = var.route53_zone_id
  origin_domain   = local.origin_fqdn
}
