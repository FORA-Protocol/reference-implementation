{
  "comment": [
    "Shared cases for the licensed path scope rule: whether a request path, as a URL carries it",
    "(percent-encoded), lies inside a listing's content_path_scope.",
    "Two implementations read this file and must agree with every case: the edge worker's",
    "inLicensedScope (src/edge/src/licensed-scope.ts, run by",
    "src/edge/tests/node/licensed-scope-vectors.test.ts) and the catalog importer's",
    "licensedscope.Classify (internal/licensedscope, run by its own test).",
    "verdict is inside, outside or undecidable. Undecidable is a path that does not decode to",
    "UTF-8, or that holds a backslash or a dot segment once decoded. The edge sends a bot to",
    "negotiate for an inside or an undecidable path (it fails closed); the importer offers only",
    "inside pages.",
    "A null or empty scope is no scope: the whole site is licensed.",
    "Left out on purpose: scope entries written percent-encoded (both sides lower-case an entry",
    "but never decode it, so such an entry does not match the pages it names), and letters that",
    "JavaScript and Go lower-case differently (U+0130, a final capital sigma).",
    "This file is checked in, never generated."
  ],
  "vectors": [
    { "name": "no scope, any path", "scope": null, "path": "/anything", "verdict": "inside" },
    { "name": "empty scope, any path", "scope": [], "path": "/anything", "verdict": "inside" },
    { "name": "no scope covers an undecidable path", "scope": [], "path": "/news/../x", "verdict": "inside" },
    { "name": "the entry itself", "scope": ["/paid/", "/q&a/"], "path": "/paid/", "verdict": "inside" },
    { "name": "a page under an entry", "scope": ["/paid/", "/q&a/"], "path": "/paid/story", "verdict": "inside" },
    { "name": "an entry with an ampersand", "scope": ["/paid/", "/q&a/"], "path": "/q&a/1", "verdict": "inside" },
    { "name": "the ampersand percent-encoded", "scope": ["/paid/", "/q&a/"], "path": "/q%26a/1", "verdict": "inside" },
    { "name": "a percent-encoded letter", "scope": ["/paid/", "/q&a/"], "path": "/%70aid/story", "verdict": "inside" },
    { "name": "a repeated leading slash", "scope": ["/paid/", "/q&a/"], "path": "//paid/story", "verdict": "inside" },
    { "name": "an upper-case path", "scope": ["/paid/", "/q&a/"], "path": "/PAID/story", "verdict": "inside" },
    { "name": "the site root", "scope": ["/paid/", "/q&a/"], "path": "/", "verdict": "outside" },
    { "name": "an unlicensed page", "scope": ["/paid/", "/q&a/"], "path": "/about", "verdict": "outside" },
    { "name": "the entry's name without its slash", "scope": ["/paid/", "/q&a/"], "path": "/paidnot", "verdict": "outside" },
    { "name": "the entry deeper in the path", "scope": ["/paid/", "/q&a/"], "path": "/free/paid/x", "verdict": "outside" },
    { "name": "an undecodable escape", "scope": ["/paid/", "/q&a/"], "path": "/%E0%A4%A/story", "verdict": "undecidable" },
    { "name": "an encoded dot segment", "scope": ["/paid/", "/q&a/"], "path": "/free/%2e%2e/paid/story", "verdict": "undecidable" },
    { "name": "an encoded backslash", "scope": ["/paid/", "/q&a/"], "path": "/free%5C..%5Cpaid/story", "verdict": "undecidable" },
    { "name": "an upper-case scope entry", "scope": ["/News/"], "path": "/news/a", "verdict": "inside" },
    { "name": "an upper-case path under a lower-case entry", "scope": ["/news/"], "path": "/NEWS/a", "verdict": "inside" },
    { "name": "a non-ASCII entry and its encoded path", "scope": ["/café/"], "path": "/caf%C3%A9/x", "verdict": "inside" },
    { "name": "lower-case hex in the escape", "scope": ["/café/"], "path": "/caf%c3%a9/x", "verdict": "inside" },
    { "name": "a non-ASCII letter in the other case", "scope": ["/Über/"], "path": "/%C3%BCber/x", "verdict": "inside" },
    { "name": "a repeated inner slash", "scope": ["/news/a/"], "path": "/news//a/b", "verdict": "inside" },
    { "name": "an entry without a trailing slash is a plain prefix", "scope": ["/news"], "path": "/newsletter/x", "verdict": "inside" },
    { "name": "the second entry", "scope": ["/archive/", "/news/"], "path": "/news/x", "verdict": "inside" },
    { "name": "dots inside a segment", "scope": ["/news/"], "path": "/news/a..b", "verdict": "inside" },
    { "name": "an encoded slash", "scope": ["/news/"], "path": "/news%2Fa", "verdict": "inside" },
    { "name": "a path shorter than the entry", "scope": ["/news/"], "path": "/news", "verdict": "outside" },
    { "name": "a dot-dot segment", "scope": ["/news/"], "path": "/news/../private/x", "verdict": "undecidable" },
    { "name": "a single-dot segment", "scope": ["/news/"], "path": "/news/./a", "verdict": "undecidable" },
    { "name": "a trailing dot-dot segment", "scope": ["/news/"], "path": "/news/..", "verdict": "undecidable" },
    { "name": "a malformed escape", "scope": ["/news/"], "path": "/news/%zz", "verdict": "undecidable" },
    { "name": "a truncated escape", "scope": ["/news/"], "path": "/news/a%", "verdict": "undecidable" },
    { "name": "an invalid UTF-8 sequence", "scope": ["/news/"], "path": "/news/%C3%28", "verdict": "undecidable" },
    { "name": "a lone high byte", "scope": ["/news/"], "path": "/news/%FF", "verdict": "undecidable" }
  ]
}
